# Сгенерируйте стойкий ключ (≥50 символов), он же подписывает JWT:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-strong-50-char-key

DEBUG=True

# Локально SQLite (по умолчанию). Для PostgreSQL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/315cargo
DATABASE_URL=sqlite:///db.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1

# --- React-панель (прод) ---
# Origin(ы) панели через запятую — для CORS и CSRF. Пример прода:
# CORS_ALLOWED_ORIGINS=https://panel.315cargo.webtm.ru
# CSRF_TRUSTED_ORIGINS=https://panel.315cargo.webtm.ru
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=

# --- Прод-хардненинг (действует только при DEBUG=0) ---
# HTTPS-редирект; отключи (0), если TLS терминируется до Django без X-Forwarded-Proto.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Тестовые OTP-номера для ревью сторов: "телефон:код" через запятую.
# Прод: смени/убери демо-номер.
OTP_TEST_NUMBERS=+996700000000:0000


# SMS (Nikita smspro.nikita.kg). Если login/password пусты — mock в логах.

SMS_BACKEND=auto

NIKITA_SMS_LOGIN=

NIKITA_SMS_PASSWORD=

NIKITA_SMS_SENDER=315CARGO

NIKITA_SMS_API_URL=https://smspro.nikita.kg/api/message

NIKITA_SMS_TEST=0

NIKITA_SMS_BRAND=315CARGO

# Nomer iz profilya Nikita (na testovom akkaunte API tol'ko na nego)
NIKITA_SMS_ALLOWED_PHONE=+996XXXXXXXXX

FCM_CREDENTIALS_PATH=

# Dotted path to PinduoduoClient implementation. Empty = no-op.

PINDUODUO_CLIENT_PATH=

JWT_ACCESS_LIFETIME_MINUTES=60

JWT_REFRESH_LIFETIME_DAYS=30

ENABLE_API_DOCS=True

REDIS_URL=redis://localhost:6379/0

