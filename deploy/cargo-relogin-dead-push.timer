[Unit]
Description=315CARGO: ежедневная чистка клиентов без рабочего push-токена

# Временная мера. Приложение отправляет токен только при входе, а после
# обновления или переустановки токен меняется — и пуши молча перестают
# доходить. Выход заставляет войти заново, вход регистрирует свежий токен.
# Снять, когда приложение начнёт слать токен при каждом запуске и в onTokenRefresh.

[Timer]
# 21:00 UTC = 03:00 Бишкек: ночью из приложения выкидывает меньше всего людей.
OnCalendar=*-*-* 21:00:00 UTC
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
